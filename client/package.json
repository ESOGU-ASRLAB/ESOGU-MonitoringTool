{
  "name": "monitoring-tool-client",
  "version": "1.0.0",
  "private": true,
  "description": "IFARLAB Digital Twin monitoring dashboard (UR10e + Kawasaki RS005L workcell).",
  "dependencies": {
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.10",
    "@react-three/postprocessing": "^2.19.1",
    "@react-three/xr": "^6.6.30",
    "postprocessing": "^6.39.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-scripts": "5.0.1",
    "three": "^0.169.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "postbuild": "node -e \"const fs=require('fs');for(const p of ['docs','vr']){fs.mkdirSync('build/'+p,{recursive:true});fs.copyFileSync('build/index.html','build/'+p+'/index.html')}fs.copyFileSync('build/index.html','build/404.html');for(const f of ['windowdoor.stl','windowlessdoor.stl'])fs.rmSync('build/new_usecase/'+f,{force:true})\"",
    "test": "react-scripts test",
    "inspection:build-meshes": "bash ../scripts/otokar/build_otokar_meshes.sh",
    "inspection:check-layout": "node ../scripts/otokar/verify_cell_fit.mjs",
    "inspection:check-palette": "node ../scripts/otokar/verify_palette.mjs",
    "inspection:inspect-meshes": "node ../scripts/otokar/inspect_meshes.mjs",
    "inspection:test-motion": "node --test ../scripts/otokar/motion.test.mjs",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "overrides": {
    "iwer": "2.2.1"
  }
}
