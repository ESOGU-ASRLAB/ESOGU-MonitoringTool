# Read by react-scripts for `npm run build` only. Set here rather than in the
# build script so it works the same on Windows (cmd) and on Render (Linux).
# Variables set in the Render dashboard still take precedence over this file.

# No .map files in the published build: they doubled the JS on disk and
# exposed the full source to anyone who asked for them.
GENERATE_SOURCEMAP=false
